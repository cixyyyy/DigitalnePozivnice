@using DigitalnePozivnice.Helpers
@model DateTimeOffset

<div class="inv-countdown" data-target="@InvitationTheme.IsoZaJs(Model)">
    <div class="inv-countdown-item"><strong data-unit="d">0</strong><span>dana</span></div>
    <div class="inv-countdown-item"><strong data-unit="h">0</strong><span>sati</span></div>
    <div class="inv-countdown-item"><strong data-unit="m">0</strong><span>minuta</span></div>
    <div class="inv-countdown-item"><strong data-unit="s">0</strong><span>sekundi</span></div>
</div>
