            <div class="al-text">
                <p class="al-kicker">@kicker</p>
                <h1 class="al-names">@glavno</h1>
                <p class="al-invite">@InvitationText.PozivLinija(Model)</p>
                @if (prvi?.DatumVreme is DateTimeOffset d)
                {
                    <p class="al-date">@InvitationTheme.DatumKratko(d)</p>
                }
                @if (!string.IsNullOrWhiteSpace(prvi?.NazivLokacije))
                {
                    <p class="al-venue">@prvi!.NazivLokacije</p>
                }
            </div>
        </div>
        <span class="tpl-scroll" aria-hidden="true"></span>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.UvodniTekst))
    {
        <section class="inv-section inv-reveal">
            <p class="inv-message">@Model.UvodniTekst</p>
        </section>
    }

    @if (prvi?.DatumVreme is DateTimeOffset cilj)
    {
        <section class="inv-section inv-reveal">
            <h2 class="inv-section-title">Još samo</h2>
            <partial name="~/Views/Pozivnice/_Odbrojavanje.cshtml" model="cilj" />
        </section>
    }

    <section class="inv-section inv-reveal">
        <h2 class="inv-section-title">Gdje i kada</h2>
        <partial name="~/Views/Pozivnice/_Dogadjaji.cshtml" model="Model" />
    </section>

    <partial name="~/Views/Pozivnice/_Galerija.cshtml" model="Model" />

    @if (imaRsvp)
    {
        <section class="inv-section inv-reveal" id="rsvp">
            <h2 class="inv-section-title">Hoćete li biti s nama?</h2>
            <partial name="~/Views/Pozivnice/_Rsvp.cshtml" model="Model" />
        </section>
    }

    <footer class="tpl-footer inv-reveal">
        <p class="tpl-footer-names">@glavno</p>
        <p class="tpl-footer-note">Ne zakasnite na čaj!</p>
    </footer>
</main>
