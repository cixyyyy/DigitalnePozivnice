@using DigitalnePozivnice.Helpers
@model DigitalnePozivnice.Models.Generated.Pozivnice

@{
    var prvi = InvitationTheme.PrviDogadjaj(Model);
    var (kicker, glavno) = InvitationTheme.Glavno(Model);
}

<main class="tpl tpl-svitak" data-float="sparkle,star,dot" data-float-count="13" data-float-sides data-float-img="@ViewData["PetalUrl"]">
    <header class="std-stage svt-stage">
        <partial name="~/Views/Pozivnice/_ArtHero.cshtml" />

        @* Zajednicke boje valjka i zlata (jednom definisane, koriste ih oba valjka) *@
        <svg class="svt-defs" width="0" height="0" aria-hidden="true" focusable="false">
            <defs>
                <linearGradient id="svtRose" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" style="stop-color:color-mix(in srgb,var(--c-main) 55%,#fff)" />
                    <stop offset=".2" style="stop-color:color-mix(in srgb,var(--c-main) 82%,#fff)" />
                    <stop offset=".58" style="stop-color:var(--c-main)" />
                    <stop offset="1" style="stop-color:color-mix(in srgb,var(--c-main) 52%,#2a1210)" />
                </linearGradient>
                <linearGradient id="svtGold" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" style="stop-color:color-mix(in srgb,var(--c-accent) 45%,#fff3c4)" />
                    <stop offset=".38" style="stop-color:var(--c-accent)" />
                    <stop offset=".7" style="stop-color:color-mix(in srgb,var(--c-accent) 78%,#3a2606)" />
                    <stop offset="1" style="stop-color:color-mix(in srgb,var(--c-accent) 55%,#3a2606)" />
                </linearGradient>
                <linearGradient id="svtGoldH" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0" style="stop-color:color-mix(in srgb,var(--c-accent) 55%,#3a2606)" />
                    <stop offset=".35" style="stop-color:color-mix(in srgb,var(--c-accent) 50%,#fff3c4)" />
                    <stop offset=".6" style="stop-color:var(--c-accent)" />
                    <stop offset="1" style="stop-color:color-mix(in srgb,var(--c-accent) 60%,#3a2606)" />
                </linearGradient>

                @* Kicanka: pocinje u (0,0) = mjesto gdje visi sa valjka *@
                <g id="svtTas">
                    <path d="M0 0 C -1 10 1 20 0 30" fill="none" stroke="url(#svtGoldH)" stroke-width="2.2" stroke-linecap="round" />
                    <circle cx="0" cy="33" r="4.6" fill="url(#svtGold)" />
                    <rect x="-3.6" y="37" width="7.2" height="4" rx="1.4" fill="url(#svtGold)" />
                    <g fill="none" stroke="url(#svtGoldH)" stroke-width="1.5" stroke-linecap="round">
                        <path d="M-3 41 C -8 52 -10 60 -11 72" />
                        <path d="M-2 41 C -5 54 -6 62 -6.5 76" />
                        <path d="M-.7 41 C -2 55 -2 64 -2.4 79" />
                        <path d="M.7 41 C 2 55 2 64 2.4 79" />
                        <path d="M2 41 C 5 54 6 62 6.5 76" />
                        <path d="M3 41 C 8 52 10 60 11 72" />
                    </g>
                </g>

                @* Valjak sa zlatnim zavrsecima (sirina 400, visina 46) *@
                <g id="svtRod">
                    <rect x="48" y="9" width="304" height="28" fill="url(#svtRose)" />
                    <rect x="48" y="9" width="304" height="28" fill="none" stroke="rgba(0,0,0,.12)" stroke-width="1" />
                    <path d="M48 12 H352" stroke="rgba(255,255,255,.35)" stroke-width="1.4" />
                    @* lijevi kraj *@
                    <rect x="42" y="6" width="9" height="34" rx="2" fill="url(#svtGold)" />
                    <path d="M42 8 C 22 4 5 11 5 23 C 5 35 22 42 42 38 Z" fill="url(#svtGold)" />
                    <path d="M38 11 C 26 10 14 14 9 21" fill="none" stroke="rgba(255,255,255,.55)" stroke-width="1.8" stroke-linecap="round" />
                    <rect x="34" y="7" width="3" height="32" rx="1.5" fill="rgba(0,0,0,.16)" />
                    @* desni kraj *@
                    <rect x="349" y="6" width="9" height="34" rx="2" fill="url(#svtGold)" />
                    <path d="M358 8 C 378 4 395 11 395 23 C 395 35 378 42 358 38 Z" fill="url(#svtGold)" />
                    <path d="M362 11 C 374 10 386 14 391 21" fill="none" stroke="rgba(255,255,255,.55)" stroke-width="1.8" stroke-linecap="round" />
                    <rect x="363" y="7" width="3" height="32" rx="1.5" fill="rgba(0,0,0,.16)" />
                </g>

                @* Fenjer (visi na koncu) *@
                <g id="svtLan">
                    <path d="M0 0 V 14" stroke="url(#svtGoldH)" stroke-width="1.2" />
                    <path d="M-5 14 H5 L6.5 18 H-6.5 Z" fill="url(#svtGold)" />
                    <path d="M-6.5 18 C -10 28 -10 38 -5.5 46 H5.5 C 10 38 10 28 6.5 18 Z" fill="var(--c-accent)" fill-opacity=".22" stroke="url(#svtGold)" stroke-width="1.4" />
                    <path d="M0 18 V 46 M-4 19 C -6 30 -5.5 38 -3 46 M4 19 C 6 30 5.5 38 3 46" fill="none" stroke="url(#svtGold)" stroke-width=".8" />
                    <ellipse class="svt-flame" cx="0" cy="32" rx="2.4" ry="5" fill="#ffe9a8" />
                    <path d="M-5.5 46 H5.5 L4 50 H-4 Z" fill="url(#svtGold)" />
                    <path d="M0 50 V 54" stroke="url(#svtGoldH)" stroke-width="1.2" />
                    <circle cx="0" cy="56" r="1.8" fill="url(#svtGold)" />
                </g>

                @* Cvijet i list za donji ukras *@
                <g id="svtFlower">
                    <g fill="color-mix(in srgb, var(--c-main) 88%, #fff)" stroke="color-mix(in srgb, var(--c-main) 55%, #5a1d2a)" stroke-width=".7">
                        <ellipse cx="0" cy="-8" rx="4.6" ry="8" />
                        <ellipse cx="0" cy="-8" rx="4.6" ry="8" transform="rotate(72)" />
                        <ellipse cx="0" cy="-8" rx="4.6" ry="8" transform="rotate(144)" />
                        <ellipse cx="0" cy="-8" rx="4.6" ry="8" transform="rotate(216)" />
                        <ellipse cx="0" cy="-8" rx="4.6" ry="8" transform="rotate(288)" />
                    </g>
                    <circle r="3.4" fill="url(#svtGold)" />
                </g>
                <path id="svtLeaf" d="M0 0 C 6 -6 14 -6 20 0 C 14 6 6 6 0 0 Z M0 0 H 17" fill="#7c9a73" stroke="#4d6b4a" stroke-width=".8" stroke-linejoin="round" />
            </defs>
        </svg>

        <p class="svt-hello rise" style="--i:0">@Loc.T("Pozvani ste")</p>

        <div class="svt" data-svitak>
            <div class="svt-rod svt-rod-top" aria-hidden="true">
                <svg viewBox="0 0 400 46" preserveAspectRatio="xMidYMid meet">
                    <use href="#svtRod" />
                    <g transform="translate(47 40)"><use class="svt-sw" href="#svtTas" /></g>
                    <g transform="translate(39 36)"><use class="svt-sw svt-sw2" href="#svtTas" /></g>
                    <g transform="translate(353 40)"><use class="svt-sw svt-sw2" href="#svtTas" /></g>
                    <g transform="translate(361 36)"><use class="svt-sw" href="#svtTas" /></g>
                </svg>
            </div>

            <div class="svt-sheet">
                <div class="svt-sheet-in">
                    <article class="svt-card">
                        <span class="svt-lattice" aria-hidden="true"></span>
                        <div class="svt-arch">
                            <svg class="svt-lan svt-lan-a" viewBox="-12 0 24 60" aria-hidden="true"><use href="#svtLan" /></svg>
                            <svg class="svt-lan svt-lan-b" viewBox="-12 0 24 60" aria-hidden="true"><use href="#svtLan" /></svg>
                            <svg class="svt-lan svt-lan-c" viewBox="-12 0 24 60" aria-hidden="true"><use href="#svtLan" /></svg>
                            <svg class="svt-lan svt-lan-d" viewBox="-12 0 24 60" aria-hidden="true"><use href="#svtLan" /></svg>

                            <div class="svt-copy">
                                <p class="svt-kicker svt-r" style="--k:0">@kicker</p>
                                <h1 class="svt-names svt-r" style="--k:1">@glavno</h1>
                                <span class="svt-orn svt-r" style="--k:2" aria-hidden="true"></span>
                                <p class="svt-invite svt-r" style="--k:3">@InvitationText.PozivLinija(Model)</p>
                                @if (prvi?.DatumVreme is DateTimeOffset d)
                                {
                                    <p class="svt-date svt-r" style="--k:4">@InvitationTheme.DatumKratko(d)</p>
                                }
                                else
                                {
                                    <p class="svt-date svt-r" style="--k:4">@Loc.T("Datum uskoro")</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(prvi?.NazivLokacije))
                                {
                                    <p class="svt-venue svt-r" style="--k:5">@prvi!.NazivLokacije</p>
                                }
                            </div>

                            <svg class="svt-garden" viewBox="0 0 300 70" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
                                <use href="#svtLeaf" transform="translate(40 58) rotate(-160) scale(1.5)" />
                                <use href="#svtLeaf" transform="translate(70 62) rotate(-35) scale(1.3)" />
                                <use href="#svtLeaf" transform="translate(110 64) rotate(-150) scale(1.2)" />
                                <use href="#svtLeaf" transform="translate(190 64) rotate(-30) scale(1.2)" />
                                <use href="#svtLeaf" transform="translate(230 62) rotate(-145) scale(1.3)" />
                                <use href="#svtLeaf" transform="translate(262 58) rotate(-20) scale(1.5)" />
                                <use href="#svtLeaf" transform="translate(150 66) rotate(-100) scale(1.3)" />
                                <use href="#svtLeaf" transform="translate(150 66) rotate(-80) scale(1.3)" />
                                <use href="#svtFlower" transform="translate(150 54) scale(1.25)" />
                                <use href="#svtFlower" transform="translate(98 56) scale(.9)" />
                                <use href="#svtFlower" transform="translate(202 56) scale(.9)" />
                                <use href="#svtFlower" transform="translate(54 60) scale(.7)" />
                                <use href="#svtFlower" transform="translate(246 60) scale(.7)" />
                            </svg>
                        </div>
                    </article>
                </div>
            </div>

            <div class="svt-rod svt-rod-bot" aria-hidden="true">
                <svg viewBox="0 0 400 46" preserveAspectRatio="xMidYMid meet">
                    <use href="#svtRod" />
                    <g transform="translate(47 40)"><use class="svt-sw svt-sw2" href="#svtTas" /></g>
                    <g transform="translate(39 36)"><use class="svt-sw" href="#svtTas" /></g>
                    <g transform="translate(353 40)"><use class="svt-sw" href="#svtTas" /></g>
                    <g transform="translate(361 36)"><use class="svt-sw svt-sw2" href="#svtTas" /></g>
                </svg>
            </div>

            <button type="button" class="svt-hit" data-svitak-toggle
                    data-open="@Loc.T("Otvori svitak")" data-close="@Loc.T("Zatvori svitak")"
                    aria-expanded="false" aria-label="@Loc.T("Otvori svitak")"></button>
        </div>

        <button type="button" class="svt-tap" data-svitak-hint data-open="@Loc.T("Dodirnite da otvorite")" data-close="@Loc.T("Dodirnite da nastavite")">@Loc.T("Dodirnite da otvorite")</button>

        <span class="svt-star svt-s1" aria-hidden="true"></span>
        <span class="svt-star svt-s2" aria-hidden="true"></span>
        <span class="svt-star svt-s3" aria-hidden="true"></span>
        <span class="svt-star svt-s4" aria-hidden="true"></span>
        <span class="svt-star svt-s5" aria-hidden="true"></span>
    </header>

    <partial name="~/Views/Pozivnice/_SaveTheDateDetalji.cshtml" model="Model" />
</main>
