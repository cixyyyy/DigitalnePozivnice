@using DigitalnePozivnice.Helpers
@model DigitalnePozivnice.Models.Generated.Pozivnice

@{
    ViewData["Title"] = "Moja pozivnica";

    var javniLink = Url.Action("JavnaPozivnica", "Pozivnice",
        new { adresa = Model.AdresaPozivnice }, Context.Request.Scheme);

    var oznaka = Model.Paket?.Oznaka;
    var imaRsvp = InvitationTheme.ImaRsvp(oznaka);
    var jeExclusive = InvitationTheme.JeExclusive(oznaka);
    var bezProgram = InvitationTheme.JeSaveTheDate(oznaka);

    var dogadjaji = Model.DogadjajiPozivnices.OrderBy(d => d.Redosled).ToList();
    var prvi = dogadjaji.FirstOrDefault();
    var naziv = string.IsNullOrWhiteSpace(Model.ImenaDomacina) ? Model.Naslov : Model.ImenaDomacina;
    var miniUrl = Url.Action("Pregled", "Pozivnice", new { id = Model.PozivnicaId, mini = true });

    // Poruka za dijeljenje (na jeziku pozivnice)
    var porukaZaDijeljenje = Loc.T("Pozivamo vas! Evo naše digitalne pozivnice:", Model.Jezik) + " " + javniLink;
    var enc = Uri.EscapeDataString(porukaZaDijeljenje);
    var subj = Uri.EscapeDataString(naziv ?? "");
    var fotoBroj = Model.MedijiPozivnices.Count(m => m.Opis == MuzikaBiblioteka.OpisFoto);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @if (Model.Objavljena)
    {
        <script src="~/js/qr.js" asp-append-version="true"></script>
        <script src="~/js/share.js" asp-append-version="true"></script>
    }
}

<section class="pz">
    <a class="pz-back" asp-controller="MojePozivnice" asp-action="Index">← Moje pozivnice</a>

    <header class="pz-head" data-rv>
        <div>
            <span class="pz-status @(Model.Objavljena ? "is-live" : "is-draft")">
                @(Model.Objavljena ? "Objavljena" : "U pripremi")
            </span>
            <h1>@naziv</h1>
            <p>
                @Model.Naslov
                @if (prvi?.DatumVreme is DateTimeOffset d)
                {
                    <text> · @InvitationTheme.DatumKratko(d)</text>
                }
            </p>
        </div>

        <div class="pz-head-actions">
            <a class="ui-btn ui-btn-ghost" asp-controller="Pozivnice" asp-action="Edit" asp-route-id="@Model.PozivnicaId">Uredi pozivnicu</a>
            <a class="ui-btn ui-btn-ghost" asp-controller="Pozivnice" asp-action="Pregled" asp-route-id="@Model.PozivnicaId" target="_blank">Pogledaj kao gost ↗</a>
        </div>
    </header>

    <div class="pz-grid">
        <div class="pz-main">

            @* Link / objava *@
            <article class="pz-card" data-rv data-rv-delay="0.05">
                @if (Model.Objavljena)
                {
                    <h2>Link za goste</h2>
                    <p class="pz-muted">Pošaljite ovaj link gostima preko poruka, Vibera ili WhatsApp-a.</p>

                    <div class="pz-copy">
                        <input id="javniLink" type="text" value="@javniLink" readonly aria-label="Link za goste" />
                        <button type="button" class="ui-btn ui-btn-solid" data-copy="#javniLink">Kopiraj</button>
                    </div>
                    <span class="pz-copy-msg" id="copyMsg" aria-live="polite"></span>

                    <div class="pz-inline">
                        <a class="ui-btn ui-btn-ghost ui-btn-sm" href="@javniLink" target="_blank" rel="noopener noreferrer">Otvori javnu pozivnicu ↗</a>
                    </div>

                    <div class="pz-share" data-share-url="@javniLink" data-share-title="@naziv" data-share-text="@porukaZaDijeljenje">
                        <a class="pz-share-btn is-wa" href="https://wa.me/?text=@enc" target="_blank" rel="noopener noreferrer">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.3-.4.7-1.3.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
                            WhatsApp
                        </a>
                        <a class="pz-share-btn is-vb" href="viber://forward?text=@enc">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-6l-4 3.5V17H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><path d="M9.5 8.5c0 3 2 5 5 5l1-1.200-1.800-1-.8.7a3.500 3.500 0 0 1-1.600-1.600l.7-.8-1-1.800z" fill="currentColor" stroke="none"/></svg>
                            Viber
                        </a>
                        <a class="pz-share-btn" href="mailto:?subject=@subj&body=@enc">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                            E-pošta
                        </a>
                        <button type="button" class="pz-share-btn" id="pzNativeShare" hidden>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="M8.2 10.8l7.6-4.4M8.2 13.2l7.6 4.4"/></svg>
                            Podijeli…
                        </button>
                    </div>
                }
                else
                {
                    <h2>Pozivnica još nije objavljena</h2>
                    <p class="pz-muted">
                        Dok je u pripremi, vidite je samo vi. Kad je objavite, gosti je mogu otvoriti preko linka.
                    </p>
                    @if ((bool)(ViewBag.Blokirana ?? false))
                    {
                        <p class="pz-muted"><span>Narudžba za ovu pozivnicu je otkazana od strane administratora, pa je objava onemogućena. Za više informacija nas kontaktirajte.</span></p>
                    }
                    else if ((bool)(ViewBag.MozeObjaviti ?? true))
                    {
                        <form asp-controller="Pozivnice" asp-action="Objavi" asp-route-id="@Model.PozivnicaId" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="ui-btn ui-btn-gold">Objavi pozivnicu</button>
                        </form>
                    }
                    else if (ViewBag.NarudzbaId is int narudzbaId)
                    {
                        <p class="pz-muted">Čekamo vašu uplatu. Čim je potvrdimo, ovdje ćete moći objaviti pozivnicu.</p>
                        <a class="ui-btn ui-btn-gold" asp-controller="Narudzbe" asp-action="Detalji" asp-route-id="@narudzbaId">Podaci za uplatu</a>
                    }
                    else
                    {
                        <p class="pz-muted"><span>Za objavu pozivnice potrebno je platiti paket:</span> <b>@(DigitalnePozivnice.Helpers.Cijene.Eur(Model.Paket?.Cena ?? 0m).ToString("N2")) € / @((Model.Paket?.Cena ?? 0m).ToString("N2")) KM</b> <span>(plaća se jednom)</span></p>
                        <a class="ui-btn ui-btn-gold" asp-controller="Narudzbe" asp-action="Placanje" asp-route-pozivnicaId="@Model.PozivnicaId">Plati i objavi</a>
                    }
                }
            </article>


            @* QR kod *@
            <article class="pz-card" id="pzQrCard" data-rv data-rv-delay="0.08">
                <h2>QR kod pozivnice</h2>
                @if (Model.Objavljena)
                {
                    <div class="pz-qr">
                        <div class="pz-qr-box"><canvas id="pzQr" data-url="@javniLink" aria-label="QR kod pozivnice"></canvas></div>
                        <div>
                            <p class="pz-muted" style="margin:0">
                                Odštampajte ga na štampanoj pozivnici, zahvalnici ili meniju – gosti ga skeniraju kamerom telefona i odmah otvaraju pozivnicu.
                            </p>
                            <div class="pz-qr-actions">
                                <button type="button" class="ui-btn ui-btn-solid ui-btn-sm" id="pzQrPng">Preuzmi PNG (za štampu)</button>
                                <button type="button" class="ui-btn ui-btn-ghost ui-btn-sm" id="pzQrSvg">Preuzmi SVG</button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="pz-muted" style="margin:0">QR kod će biti dostupan čim objavite pozivnicu.</p>
                }
            </article>

            @* Upravljanje *@
            <div class="pz-tiles" data-rv data-rv-delay="0.1">
                <a class="pz-tile" asp-controller="Pozivnice" asp-action="Edit" asp-route-id="@Model.PozivnicaId">
                    <span class="pz-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4z"/><path d="M13.5 6.5l4 4"/></svg></span>
                    <b>Uredi pozivnicu</b>
                    <small>Ispravite imena, datum, program ili poruku</small>
                </a>

                @if (imaRsvp)
                {
                    <a class="pz-tile" asp-controller="Upravljanje" asp-action="Potvrde" asp-route-id="@Model.PozivnicaId">
                        <span class="pz-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg></span>
                        <b>Potvrde dolaska</b>
                        <small>Ko dolazi, ko ne, i izvoz liste gostiju</small>
                    </a>
                }
                else
                {
                    <a class="pz-tile is-locked" asp-controller="Paketi" asp-action="Index">
                        <span class="pz-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
                        <b>Potvrde dolaska</b>
                        <small>Dostupno u paketima Premium i Exclusive</small>
                    </a>
                }

                @if (jeExclusive)
                {
                    <a class="pz-tile" asp-controller="Upravljanje" asp-action="Raspored" asp-route-id="@Model.PozivnicaId">
                        <span class="pz-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><circle cx="12" cy="3.5" r="1.5"/><circle cx="12" cy="20.5" r="1.5"/><circle cx="3.5" cy="12" r="1.5"/><circle cx="20.5" cy="12" r="1.5"/></svg></span>
                        <b>Raspored sjedenja</b>
                        <small>Rasporedite goste po stolovima</small>
                    </a>
                }
                else
                {
                    <a class="pz-tile is-locked" asp-controller="Paketi" asp-action="Index">
                        <span class="pz-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
                        <b>Raspored sjedenja</b>
                        <small>Dostupno u paketu Exclusive</small>
                    </a>
                }
            </div>

            @* Fotografije i muzika *@
            @if (imaRsvp)
            {
                <article class="pz-card" data-rv data-rv-delay="0.12">
                    <h2>Fotografije i muzika</h2>
                    <p class="pz-muted">Dodajte svoje fotografije u galeriju pozivnice i izaberite muziku koja svira dok gosti gledaju.</p>
                    @if (fotoBroj > 0)
                    {
                        <div class="pz-thumbs">
                            @foreach (var f in Model.MedijiPozivnices.Where(m => m.Opis == MuzikaBiblioteka.OpisFoto).OrderBy(m => m.Redosled).Take(6))
                            {
                                <img src="@MuzikaBiblioteka.MedijUrl(f)" alt="" loading="lazy" />
                            }
                        </div>
                    }
                    <div class="pz-media-tiles">
                        <a class="ui-btn ui-btn-solid ui-btn-sm" href="/moje-pozivnice/@Model.PozivnicaId/mediji">Uredi fotografije i muziku</a>
                    </div>
                </article>
            }
            else
            {
                <article class="pz-card" data-rv data-rv-delay="0.12">
                    <h2>Fotografije i muzika</h2>
                    <p class="pz-muted">Galerija fotografija, izbor muzike i vlastita pjesma dostupni su u paketima Premium i Exclusive.</p>
                    <a class="ui-btn ui-btn-ghost ui-btn-sm" asp-controller="Paketi" asp-action="Index">Pogledaj pakete</a>
                </article>
            }

            @* Sazetak *@
            <article class="pz-card" data-rv data-rv-delay="0.15">
                <h2>Sažetak</h2>

                <dl class="pz-dl">
                    <div><dt>Paket</dt><dd>@Model.Paket?.Naziv</dd></div>
                    <div><dt>Dizajn</dt><dd>@Model.Sablon?.Naziv</dd></div>
                    @if (prvi?.DatumVreme is DateTimeOffset dd)
                    {
                        <div><dt>Datum</dt><dd>@InvitationTheme.DatumDugo(dd)</dd></div>
                    }
                </dl>

                @if (!bezProgram && dogadjaji.Count > 0)
                {
                    <h3 class="pz-sub">Program</h3>
                    <ul class="pz-program">
                        @foreach (var s in dogadjaji)
                        {
                            <li>
                                <time>@(s.DatumVreme.HasValue ? InvitationTheme.Vreme(s.DatumVreme.Value) : "")</time>
                                <div>
                                    <b>@s.Naziv</b>
                                    @if (!string.IsNullOrWhiteSpace(s.NazivLokacije) || !string.IsNullOrWhiteSpace(s.Adresa))
                                    {
                                        <small>@s.NazivLokacije@(string.IsNullOrWhiteSpace(s.Adresa) ? "" : ", " + s.Adresa)</small>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }

                @if (!string.IsNullOrWhiteSpace(Model.UvodniTekst))
                {
                    <h3 class="pz-sub">Poruka gostima</h3>
                    <p class="pz-quote">@Model.UvodniTekst</p>
                }
            </article>
        </div>

        <aside class="pz-side" data-rv="right" data-rv-delay="0.1">
            <div class="pz-phone">
                <span class="pz-notch" aria-hidden="true"></span>
                <div class="pz-screen" id="pzScreen">
                    <iframe src="@miniUrl" title="Pregled pozivnice" scrolling="no" tabindex="-1"></iframe>
                </div>
            </div>
            <p class="pz-side-note">Tako pozivnica izgleda na telefonu</p>
        </aside>
    </div>
</section>
