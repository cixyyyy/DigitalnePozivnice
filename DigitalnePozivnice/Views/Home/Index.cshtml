@{
    ViewData["Title"] = "Digitalne pozivnice za vjenčanja i proslave";
}

@section Styles {
    <link rel="stylesheet" href="~/css/sabloni.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-showcase.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-lang.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-extra.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
    <script src="~/js/sabloni.js" asp-append-version="true"></script>
    <script src="~/js/lang-promo.js" asp-append-version="true"></script>
}

@* =========================================================
   HERO
   ========================================================= *@
<section class="hx" id="top">
    <div class="hx-aurora" aria-hidden="true"><i></i><i></i><i></i></div>

    <div class="hx-inner">
        <span class="hx-pill hx-in" style="--d:.1s"><b></b> Nova generacija digitalnih pozivnica</span>

        <h1 class="hx-title hx-in" style="--d:.28s">
            <span class="hx-line">Digitalne pozivnice za</span>
            <span class="hx-rot" data-rot aria-live="polite">
                <span class="hx-word is-active" style="--wc:#b8935a;--wc2:#e6c58d">vjenčanja</span>
                <span class="hx-word" style="--wc:#6f8f66;--wc2:#a9c9a0">krštenja</span>
                <span class="hx-word" style="--wc:#d0677c;--wc2:#f2a6b6">rođendane</span>
                <span class="hx-word" style="--wc:#8564b8;--wc2:#b99be6">proslave</span>
                <span class="hx-word" style="--wc:#3f86b3;--wc2:#7cc3ea">godišnjice</span>
            </span>
        </h1>

        <p class="hx-sub hx-in" style="--d:.55s"
           data-typewriter="Vaša pozivnica je prvi utisak o vašem velikom danu. Učinite ga nezaboravnim.">
            <span class="visually-hidden">Vaša pozivnica je prvi utisak o vašem velikom danu. Učinite ga nezaboravnim.</span>
            <span class="hx-sub-ghost" aria-hidden="true">Vaša pozivnica je prvi utisak o vašem velikom danu. Učinite ga nezaboravnim.</span>
            <span class="hx-sub-type" aria-hidden="true"></span>
        </p>

        <div class="hx-actions hx-in" style="--d:1s">
            <a asp-controller="Paketi" asp-action="Index" class="btn-elegant">
                Kreiraj svoju pozivnicu <span>↗</span>
            </a>
            <a href="#kako-funkcionise" class="btn-text">Kako funkcioniše ↓</a>
        </div>

        <ul class="hx-trust hx-in" style="--d:1.2s">
            <li>Bez aplikacije za goste</li>
            <li>Potvrde dolaska</li>
            <li>Na svakom uređaju</li>
        </ul>
    </div>

    <div class="hx-stage hx-in hx-in-zoom" style="--d:.9s" aria-hidden="true">
        <div class="phone">
            <div class="phone-glow"></div>
            <div class="phone-tilt">
                <div class="phone-frame">
                    <span class="phone-notch"></span>
                    <div class="phone-screen">

                        <div class="hx-live" data-hero-live data-src="@Url.Action("Demo", "Sabloni", new { kljuc = "slot-masina", mini = true, auto = 1 })">
                            <div class="hx-live-skeleton"></div>
                            <iframe title="Slot mašina" tabindex="-1" scrolling="no"></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="hx-chip hx-chip-1"><span>✉</span><div><b>Pozivnica poslata</b><small>128 gostiju</small></div></div>
        <div class="hx-chip hx-chip-2"><span>✓</span><div><b>Marija potvrdila dolazak</b><small>upravo sada</small></div></div>
        <div class="hx-chip hx-chip-3"><span>♥</span><div><b>86 potvrđenih</b><small>od 118 gostiju</small></div></div>
    </div>
</section>

@{
    var marqueeTeme = new[] { "Vjenčanja", "Krštenja", "Rođendani", "Godišnjice", "Proslave", "Mature" };
}
<div class="hx-marquee" aria-hidden="true">
    @* Dvije identicne grupe; staza se pomjera za tacno jednu grupu pa je petlja bez prekida:
       poslije posljednje rijeci odmah ide prva. *@
    <div class="hx-marquee-track">
        @for (var g = 0; g < 2; g++)
        {
            <div class="hx-marquee-group">
                @for (var r = 0; r < 4; r++)
                {
                    foreach (var tema in marqueeTeme)
                    {
                        <span>@tema</span><i>✦</i>
                    }
                }
            </div>
        }
    </div>
</div>

@* =========================================================
   UVOD
   ========================================================= *@
<section class="intro-section">
    <span class="eyebrow">MALI DETALJI. VELIKE USPOMENE.</span>
    <h2>Vi slavite ljubav.<br /><em>Mi ćemo se pobrinuti za pozivnice.</em></h2>
    <p>
        Sve što je vašim gostima potrebno, objedinjeno u jednoj
        prelijepoj digitalnoj pozivnici.
    </p>
</section>

<section class="hl-sec">
    <ul class="hl-grid">
        <li class="hl-card" data-rv data-rv-delay="0.0"><span class="hl-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 4.6L18.5 9l-4.6 1.9L12 15.5l-1.9-4.6L5.5 9l4.6-1.4z"/><path d="M19 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg></span><h3>Animirane pozivnice</h3><p>Slot mašina, koverta, svitak i još mnogo toga.</p></li>
        <li class="hl-card" data-rv data-rv-delay="0.1"><span class="hl-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/><circle cx="12" cy="12" r="9.5"/></svg></span><h3>Potvrde dolaska</h3><p>Gosti odgovaraju jednim dodirom, a vi sve vidite uživo.</p></li>
        <li class="hl-card" data-rv data-rv-delay="0.2"><span class="hl-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19M12 2.5c2.7 2.9 4 6 4 9.5s-1.3 6.600-4 9.500c-2.700-2.900-4-6-4-9.500s1.300-6.600 4-9.500z"/></svg></span><h3>Šest jezika</h3><p>Pozivnica i sajt na jeziku vaših gostiju.</p></li>
        <li class="hl-card" data-rv data-rv-delay="0.3"><span class="hl-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.700 5.700l1-1"/></svg></span><h3>Jedinstven link</h3><p>Podijelite jednim linkom, bez aplikacije za goste.</p></li>
    </ul>
</section>

@* =========================================================
   ADMIN PANEL
   ========================================================= *@
<section class="adm-sec" id="admin-panel">
    <div class="adm-head" data-rv>
        <span class="eyebrow">VAŠ PRIVATNI ADMIN PANEL</span>
        <h2>Sve potvrde na jednom mjestu. <em>U realnom vremenu.</em></h2>
        <p>Pratite ko dolazi, izvezite listu gostiju i rasporedite stolove, bez ijedne tabele.</p>
    </div>

    <div class="adm-grid">
        <ul class="adm-features">
            <li data-rv="left" data-rv-delay=".05">
                <span class="adm-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg></span>
                <div><h3>Potvrde u realnom vremenu</h3><p>Odmah vidite ko dolazi, ko je odbio, a ko još nije odgovorio.</p></div>
            </li>
            <li data-rv="left" data-rv-delay=".15">
                <span class="adm-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg></span>
                <div><h3>Izvoz liste gostiju</h3><p>Preuzmite spisak gostiju jednim klikom, spreman za restoran ili ketering.</p></div>
            </li>
            <li data-rv="left" data-rv-delay=".25">
                <span class="adm-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v3M14 20h3M20 20h1"/></svg></span>
                <div><h3>QR kod vaše pozivnice</h3><p>Preuzmite QR kod za štampu na karticama, kovertama i tablama u prostoru.</p></div>
            </li>
            <li data-rv="left" data-rv-delay=".35">
                <span class="adm-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><circle cx="12" cy="3.5" r="1.5"/><circle cx="12" cy="20.5" r="1.5"/><circle cx="3.5" cy="12" r="1.5"/><circle cx="20.5" cy="12" r="1.5"/></svg></span>
