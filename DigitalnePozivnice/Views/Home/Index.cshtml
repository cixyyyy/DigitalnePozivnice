@* =========================================================
   DIZAJNI
   ========================================================= *@
<section class="templates-section" id="sabloni">
    <div class="section-heading">
        <div>
            <span class="eyebrow">PRONAĐITE SVOJ STIL</span>
            <h2>Dizajni koji osvajaju <em>na prvi pogled.</em></h2>
        </div>

        <a asp-controller="Paketi" asp-action="Index" class="btn-text">Kreiraj pozivnicu ↗</a>
    </div>

    <div class="hs-grid">
        <article class="hs-card" data-rv data-rv-delay="0">
            <a class="hs-link" asp-controller="Sabloni" asp-action="Demo" asp-route-lang="@Loc.Lang" asp-route-kljuc="slot-masina" target="_blank" rel="noopener" aria-label="Pogledaj demo: Slot mašina">
                <span class="hs-num">01</span>
                <div class="hs-phone">
                    <span class="hs-notch" aria-hidden="true"></span>
                    <div class="sg-screen hs-screen" data-src="@Url.Action("Demo", "Sabloni", new { kljuc = "slot-masina", mini = true })">
                        <div class="sg-skeleton" aria-hidden="true"></div>
                        <iframe title="Pregled: Slot mašina" tabindex="-1" scrolling="no"></iframe>
                    </div>
                </div>
                <span class="hs-live">Pogledaj demo <b>↗</b></span>
            </a>
            <div class="hs-info">
                <h3>Slot mašina</h3>
                <p>Povucite ručicu i datum se otkriva uz svjetla i konfete.</p>
            </div>
        </article>
        <article class="hs-card" data-rv data-rv-delay="0.12">
            <a class="hs-link" asp-controller="Sabloni" asp-action="Demo" asp-route-lang="@Loc.Lang" asp-route-kljuc="koverta" target="_blank" rel="noopener" aria-label="Pogledaj demo: Koverta">
                <span class="hs-num">02</span>
                <div class="hs-phone">
                    <span class="hs-notch" aria-hidden="true"></span>
                    <div class="sg-screen hs-screen" data-src="@Url.Action("Demo", "Sabloni", new { kljuc = "koverta", mini = true })">
                        <div class="sg-skeleton" aria-hidden="true"></div>
                        <iframe title="Pregled: Koverta" tabindex="-1" scrolling="no"></iframe>
                    </div>
                </div>
                <span class="hs-live">Pogledaj demo <b>↗</b></span>
            </a>
            <div class="hs-info">
                <h3>Koverta</h3>
                <p>Pečat se lomi, koverta se otvara i pozivnica izlazi.</p>
            </div>
        </article>
        <article class="hs-card" data-rv data-rv-delay="0.24">
            <a class="hs-link" asp-controller="Sabloni" asp-action="Demo" asp-route-lang="@Loc.Lang" asp-route-kljuc="romanticni-vrt" target="_blank" rel="noopener" aria-label="Pogledaj demo: Romantični vrt">
                <span class="hs-num">03</span>
                <div class="hs-phone">
                    <span class="hs-notch" aria-hidden="true"></span>
                    <div class="sg-screen hs-screen" data-src="@Url.Action("Demo", "Sabloni", new { kljuc = "romanticni-vrt", mini = true })">
                        <div class="sg-skeleton" aria-hidden="true"></div>
                        <iframe title="Pregled: Romantični vrt" tabindex="-1" scrolling="no"></iframe>
                    </div>
                </div>
                <span class="hs-live">Pogledaj demo <b>↗</b></span>
            </a>
            <div class="hs-info">
                <h3>Romantični vrt</h3>
                <p>Cvjetni detalji, program, mapa i potvrda dolaska.</p>
            </div>
        </article>
    </div>

    <div class="hs-foot">
        <span class="hs-foot-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2.5" width="10" height="19" rx="2.6"/><path d="M11 18.2h2"/></svg>
        </span>
        <p class="hs-foot-text">
            Ovo su pravi dizajni u radu, sa izmišljenim podacima. Kliknite na telefon da vidite
            demo. Boje, pozadinu i tekst prilagođavate svojoj proslavi.
        </p>
        <a asp-controller="Paketi" asp-action="Index" class="btn-elegant hs-foot-cta">
            Pogledaj pakete i kreiraj pozivnicu <span>↗</span>
        </a>
    </div>
</section>

@* =========================================================
   JEZICI
   ========================================================= *@
<section class="lp-sec" id="jezici">
    <div class="lp-inner">
        <div class="lp-copy" data-rv>
            <span class="eyebrow">VIŠE JEZIKA</span>
            <h2>Pozivnica na jeziku <em>vaših gostiju.</em></h2>
            <p>
                Vaši gosti dolaze iz različitih krajeva? Pozivnicu možete napraviti na srpskom, hrvatskom,
                bosanskom, slovenskom, njemačkom ili engleskom jeziku, a cijeli sajt možete koristiti na
                jeziku koji vam najviše odgovara.
            </p>
            <p class="lp-sub">Poruke, program, datumi i dugmad prilagođavaju se izabranom jeziku.</p>

            <div class="lp-pills" role="tablist" translate="no">
                @foreach (var j in Loc.Jezici)
                {
                    <button type="button" class="lp-pill" data-lp="@j.Code" role="tab">@j.Native</button>
                }
            </div>
            <p class="lp-hint">Odaberite jezik pozivnice u koraku personalizacije.</p>
        </div>

        <div class="lp-stage" data-rv data-rv-delay="0.15" aria-hidden="true">
            <div class="lp-glow"></div>
            <div class="lp-card lp-card-back"></div>
            <div class="lp-card" id="lp-card">
                <small data-k="kicker"></small>
                <h3 data-k="names"></h3>
                <p data-k="line"></p>
                <b data-k="date"></b>
                <span class="lp-btn" data-k="btn"></span>
                <span class="lp-code" data-k="code"></span>
            </div>
        </div>
    </div>
</section>

